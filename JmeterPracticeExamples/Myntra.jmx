          <stringProp name="HTTPSampler.path">/auth?redirect=https%3A%2F%2Fwww.meesho.com%2F&amp;source=profile&amp;entry=header&amp;screen=HP</stringProp>
          <boolProp name="HTTPSampler.follow_redirects">true</boolProp>
